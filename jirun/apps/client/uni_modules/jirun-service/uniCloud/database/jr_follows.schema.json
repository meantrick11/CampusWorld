{
  "bsonType": "object",
  "required": ["actorId", "targetUserId", "createdAt"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "记录 ID，由云端生成"
    },
    "actorId": {
      "bsonType": "string",
      "description": "关注发起者用户 ID，由服务端 token 校验得出"
    },
    "targetUserId": {
      "bsonType": "string",
      "description": "被关注的用户 ID；不能与 actorId 相同"
    },
    "createdAt": {
      "bsonType": "long",
      "description": "关注时间，服务端生成的 Unix 毫秒"
    }
  }
}
