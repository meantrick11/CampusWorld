        </mxCell>
        <mxCell id="01-main-s1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#fff3db;strokeColor=#bc7d16;" value="下单支付后发布&#xa;支付成功可接单；接入待核实" vertex="1">
          <mxGeometry height="86" width="380" x="90" y="305" as="geometry" />
        </mxCell>
        <mxCell id="01-main-s2" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eaf2ff;strokeColor=#3974c6;" value="待接单大厅&#xa;展示条件，隐藏敏感信息" vertex="1">
          <mxGeometry height="86" width="380" x="90" y="455" as="geometry" />
        </mxCell>
        <mxCell id="01-main-s3" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eaf2ff;strokeColor=#3974c6;" value="判断并确认接单&#xa;需配合则先选五分钟取件区间" vertex="1">
          <mxGeometry height="86" width="380" x="90" y="605" as="geometry" />
        </mxCell>
        <mxCell id="01-main-s4" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eaf2ff;strokeColor=#3974c6;" value="实际取件并配送&#xa;动态码流程见第二页" vertex="1">
          <mxGeometry height="86" width="380" x="90" y="755" as="geometry" />
        </mxCell>
        <mxCell id="01-main-s5" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#fff3db;strokeColor=#bc7d16;" value="先点已送达 → 用户确认结算&#xa;特殊附照片；3h未确认转代审" vertex="1">
          <mxGeometry height="86" width="380" x="90" y="905" as="geometry" />
        </mxCell>
        <mxCell id="01-main-s6" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#fff3db;strokeColor=#bc7d16;" value="完成履约 → 报酬结算&#xa;资金到账结果单独跟踪" vertex="1">
