        </mxCell>
        <mxCell id="02-pickup-e1" value="2)" style="html=0;rounded=0;endArrow=block;labelBackgroundColor=#ffffff;fontSize=15;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;" edge="1" parent="1" source="02-pickup-s1" target="02-pickup-s2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="02-pickup-e2" value="3)" style="html=0;rounded=0;endArrow=block;labelBackgroundColor=#ffffff;fontSize=15;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;" edge="1" parent="1" source="02-pickup-s2" target="02-pickup-s3">
