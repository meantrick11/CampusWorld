        <mxCell id="02-pickup-e4" value="5)" style="html=0;rounded=0;endArrow=block;labelBackgroundColor=#ffffff;fontSize=15;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;" edge="1" parent="1" source="02-pickup-s4" target="02-pickup-s5">
          <mxGeometry as="geometry" relative="1" />
