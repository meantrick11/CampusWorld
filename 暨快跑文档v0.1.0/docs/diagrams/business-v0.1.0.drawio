        <mxCell id="03-exceptions-b0" value="取件状态不明&#xa;继续核实；不得立即重复派单" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#ffebeb;strokeColor=#bf5050;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="305" width="380" height="86" />
