        </mxCell>
        <mxCell id="01-main-b0" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#ffebeb;strokeColor=#bf5050;" value="支付失败或结果不明&#xa;核实后重试，不重复扣款" vertex="1">
