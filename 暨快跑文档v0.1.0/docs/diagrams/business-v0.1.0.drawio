        <mxCell id="01-main-s0" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eaf2ff;strokeColor=#3974c6;" value="用户填写固定 A→B 需求&#xa;同地点多件整单；不同地点另发" vertex="1">
