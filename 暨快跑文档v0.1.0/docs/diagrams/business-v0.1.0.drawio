  <diagram id="02-pickup" name="动态码与取件流程">
    <mxGraphModel dx="1240" dy="1110" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1240" pageHeight="1110">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="02-pickup-title" value="暨快跑｜动态码与取件流程 · v0.1.0" style="text;html=0;align=left;verticalAlign=middle;fontSize=26;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="25" width="1100" height="45" />
        </mxCell>
        <mxCell id="02-pickup-legend" value="编号实线：主路径 ｜ 灰虚线：条件分支 ｜ 蓝：业务步骤 ｜ 橙：待定／外部依赖 ｜ 红：异常" style="text;html=0;align=left;verticalAlign=middle;fontSize=16;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="83" width="1120" height="40" />
        </mxCell>
        <mxCell id="02-pickup-s0" value="需用户即时配合的订单&#xa;接单前选到站区间并同步用户" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eaf2ff;strokeColor=#3974c6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="155" width="380" height="86" />
        </mxCell>
        <mxCell id="02-pickup-s1" value="点击“索要动态码”&#xa;通知用户；较久未回可电话联系" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eaf2ff;strokeColor=#3974c6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="305" width="380" height="86" />
        </mxCell>
        <mxCell id="02-pickup-s2" value="用户响应并上传&#xa;三分钟有效期需现场核实" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#fff3db;strokeColor=#bc7d16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="455" width="380" height="86" />
        </mxCell>
        <mxCell id="02-pickup-s3" value="驿站核验代取权限&#xa;核对本单包裹，授权方式待核实" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#fff3db;strokeColor=#bc7d16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="605" width="380" height="86" />
        </mxCell>
        <mxCell id="02-pickup-s4" value="实际取得正确物品&#xa;拿到码不等于取件完成" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eaf2ff;strokeColor=#3974c6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="755" width="380" height="86" />
        </mxCell>
        <mxCell id="02-pickup-s5" value="确认已取件，开始配送&#xa;送往用户指定交付位置" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eaf2ff;strokeColor=#3974c6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="905" width="380" height="86" />
        </mxCell>
        <mxCell id="02-pickup-b0" value="联系失败，实际尚未取件&#xa;按约到站等待三分钟可自行终止" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#ffebeb;strokeColor=#bf5050;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="455" width="380" height="86" />
        </mxCell>
        <mxCell id="02-pickup-b1" value="拒绝代取／物品不符&#xa;暂停，联系用户协商" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#ffebeb;strokeColor=#bf5050;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="605" width="380" height="86" />
        </mxCell>
        <mxCell id="02-pickup-b2" value="只取到部分物品&#xa;双方确认减件及金额后继续" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#ffebeb;strokeColor=#bf5050;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="755" width="380" height="86" />
        </mxCell>
        <mxCell id="02-pickup-e0" value="1)" style="html=0;rounded=0;endArrow=block;labelBackgroundColor=#ffffff;fontSize=15;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;" edge="1" parent="1" source="02-pickup-s0" target="02-pickup-s1">
