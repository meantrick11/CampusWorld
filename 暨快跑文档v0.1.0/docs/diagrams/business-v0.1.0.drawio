        <mxCell id="03-exceptions-s2" value="尝试协商能否继续&#xa;能继续返回原流程；否则分阶段" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eaf2ff;strokeColor=#3974c6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="455" width="380" height="86" />
        </mxCell>
        <mxCell id="03-exceptions-s3" value="记录双方处理结果&#xa;普通取消双方同意；失联按规则" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eaf2ff;strokeColor=#3974c6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="605" width="380" height="86" />
        </mxCell>
        <mxCell id="03-exceptions-s4" value="执行处理并通知&#xa;未取件可协商退出；已取件先交接" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eaf2ff;strokeColor=#3974c6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="755" width="380" height="86" />
        </mxCell>
        <mxCell id="03-exceptions-s5" value="跟踪资金与结果&#xa;正常取消原路退款；完成才获酬" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#fff3db;strokeColor=#bc7d16;" vertex="1" parent="1">
